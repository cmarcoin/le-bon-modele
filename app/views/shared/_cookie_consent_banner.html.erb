<% if ENV["GA_MEASUREMENT_ID"].present? %>
  <div id="cookie-consent-banner"
       class="hidden fixed bottom-6 left-0 right-0 lg:left-6 lg:right-auto lg:w-[400px] z-[6000] bg-white border border-[#E7E2DC] lg:rounded-[20px] shadow-[0_-4px_20px_rgba(0,0,0,0.08)] lg:shadow-[0_8px_32px_rgba(0,0,0,0.12)]"
       data-controller="cookie-consent">
    <div class="px-6 py-5 lg:p-6">
      <div class="flex flex-col gap-4">
        <!-- Texte -->
        <div>
          <h2 class="font-heading text-lg font-bold text-brand-text">Respect de votre vie privée</h2>
          <p class="mt-1.5 font-body text-sm leading-relaxed text-brand-text-secondary lg:text-sm lg:leading-[22px]">
            Avec votre accord, nous utilisons des cookies pour mesurer l'audience du site et l'améliorer. Vous pouvez changer d'avis à tout moment via «&nbsp;Gérer les cookies&nbsp;», en bas de page.
          </p>
        </div>

        <!-- Boutons -->
        <div class="flex flex-row gap-3">
          <button data-action="click->cookie-consent#refuse"
                  class="flex-1 rounded-full border-2 border-brand-primary bg-transparent px-3 py-[11px] font-heading text-sm font-bold text-brand-primary transition-all hover:bg-brand-primary hover:text-white focus:outline-none focus:ring-2 focus:ring-brand-primary focus:ring-offset-2">
            Tout refuser
          </button>

          <button data-action="click->cookie-consent#accept"
                  class="flex-1 rounded-full border-2 border-brand-primary bg-brand-primary px-3 py-[11px] font-heading text-sm font-bold text-white transition-all hover:bg-[#174A2E] focus:outline-none focus:ring-2 focus:ring-brand-primary focus:ring-offset-2">
            Tout accepter
          </button>
        </div>
      </div>
    </div>
  </div>
<% end %>
