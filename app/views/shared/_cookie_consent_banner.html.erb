<% if ENV["GA_MEASUREMENT_ID"].present? %>
  <div id="cookie-consent-banner" 
       class="hidden fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-[#E7E2DC] shadow-[0_-4px_20px_rgba(0,0,0,0.08)]"
       data-controller="cookie-consent">
    <div class="max-w-7xl mx-auto px-6 py-6 lg:px-8 lg:py-8">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-8">
        <!-- Texte -->
        <div class="flex-1">
          <h2 class="font-heading text-lg font-bold text-brand-text lg:text-xl">Respect de votre vie privée</h2>
          <p class="mt-2 font-body text-sm leading-relaxed text-brand-text-secondary lg:text-base">
            Nous utilisons des cookies pour analyser l'audience du site et améliorer votre expérience. 
            Vous pouvez accepter, refuser ou personnaliser vos choix. Votre choix est conservé 6 mois.
          </p>
        </div>

        <!-- Boutons -->
        <div class="flex flex-col gap-3 lg:flex-row lg:gap-4">
          <button data-action="click->cookie-consent#refuse" 
                  class="rounded-full border-2 border-brand-primary bg-transparent px-6 py-3 font-heading text-sm font-bold text-brand-primary transition-all hover:bg-brand-primary hover:text-white focus:outline-none focus:ring-2 focus:ring-brand-primary focus:ring-offset-2 lg:px-8 lg:text-base">
            Tout refuser
          </button>
          
          <button data-action="click->cookie-consent#accept" 
                  class="rounded-full border-2 border-brand-primary bg-brand-primary px-6 py-3 font-heading text-sm font-bold text-white transition-all hover:bg-[#174A2E] focus:outline-none focus:ring-2 focus:ring-brand-primary focus:ring-offset-2 lg:px-8 lg:text-base">
            Tout accepter
          </button>
        </div>
      </div>
    </div>
  </div>
<% end %>
