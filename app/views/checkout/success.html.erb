<% content_for :title, "Paiement confirmé | Le Bon Modèle" %>

<%= render "home/header" %>

<main class="relative pt-24">
  <%= render "home/background_pattern" %>
  <section class="relative px-6 pt-8 pb-20 lg:px-12 lg:pt-10 lg:pb-[120px]">
    <div class="mx-auto max-w-[1280px]">
      <% if @booking&.paid? %>
        <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-14">
          <div class="lg:pt-[164px]">
            <h1 class="font-heading text-[32px] font-black leading-[0.98] lg:text-[48px]">
              <span class="block text-brand-primary">C'est réservé !</span>
              <span class="mt-[10px] block text-brand-text lg:mt-4">À très vite, <%= @booking.customer_name.split.first %>.</span>
            </h1>

            <p class="mt-5 max-w-[560px] text-[18px] leading-[1.5] lg:mt-8 lg:text-[20px] text-brand-text-secondary">
              Votre paiement pour le <%= @booking.pack.name %> a bien été reçu.
            </p>

            <div class="mt-7 max-w-[560px] rounded-[20px] bg-[#F3F7EF] p-5 lg:mt-8 lg:rounded-[24px] lg:px-8 lg:py-7">
              <div class="space-y-5">
                <div class="flex items-start gap-4">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white">
                    <svg class="h-5 w-5 text-brand-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                      <path d="M3 10h18M8 3v4M16 3v4"></path>
                    </svg>
                  </div>
                  <div>
                    <p class="text-base font-bold text-brand-text"><%= paris_datetime_full(@booking.availability_slot.starts_at) %></p>
                    <p class="mt-0.5 text-sm text-brand-text-secondary">Premier entretien · 60 minutes</p>
                  </div>
                </div>

                <div class="flex items-start gap-4">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white">
                    <% if @booking.meeting_mode == "visio" %>
                      <svg class="h-5 w-5 text-brand-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M23 7l-7 5 7 5V7z"></path>
                        <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                      </svg>
                    <% else %>
                      <svg class="h-5 w-5 text-brand-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path>
                      </svg>
                    <% end %>
                  </div>
                  <div>
                    <p class="text-base font-bold text-brand-text">
                      <% if @booking.meeting_mode == "visio" %>
                        En visio
                      <% else %>
                        Par téléphone
                      <% end %>
                    </p>
                    <p class="mt-0.5 text-sm text-brand-text-secondary">
                      <% if @booking.meeting_mode == "visio" %>
                        Le lien de connexion et le questionnaire préparatoire vous seront adressés quelques jours avant l'entretien
                      <% else %>
                        Charles et Jules vous appelleront au numéro indiqué. Le questionnaire préparatoire vous sera adressé quelques jours avant l'entretien
                      <% end %>
                    </p>
                  </div>
                </div>

                <div class="flex items-start gap-4">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white">
                    <svg class="h-5 w-5 text-brand-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12.5 10 17l9-10"></path>
                    </svg>
                  </div>
                  <div>
                    <p class="text-base font-bold text-brand-text"><%= @booking.pack.name %> · <%= euro_price(@booking.amount_cents) %> TTC</p>
                    <p class="mt-0.5 text-sm text-brand-text-secondary">Paiement reçu</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="mt-8 flex flex-col items-center gap-5 lg:mt-10 lg:flex-row lg:gap-8">
              <%= link_to "Retour à l'accueil", root_path, class: "inline-flex h-14 w-full items-center justify-center rounded-full bg-brand-primary px-8 text-base font-bold text-white lg:w-auto" %>
              <%= link_to contact_path, class: "text-base font-bold text-brand-primary" do %>
                Une question ? Contactez-nous →
              <% end %>
            </div>
          </div>

          <div class="flex items-center justify-center lg:justify-end">
            <%= image_tag "/reference-assets/voiture-choisie.svg", width: 680, height: 280, alt: "", class: "h-auto w-full max-w-[612px]", loading: "lazy" %>
          </div>
        </div>
      <% else %>
        <div class="mx-auto max-w-4xl rounded-[28px] border border-[#E7E2DC] bg-white p-8 text-center shadow-soft lg:p-12">
          <p class="text-[20px] font-bold text-brand-primary">Paiement en cours</p>
          <h1 class="mt-3 font-heading text-[42px] font-bold leading-none text-brand-text sm:text-[56px]">Votre rendez-vous est en cours de réservation</h1>
          <p class="mx-auto mt-6 max-w-2xl text-[20px] leading-[1.5] text-brand-text-secondary">
            Stripe a bien redirigé votre paiement. La confirmation définitive arrivera dès que le webhook Stripe aura validé la transaction.
          </p>
          <%= link_to "Retour à l'accueil", root_path, class: "mt-8 inline-flex min-h-[58px] items-center justify-center rounded-full bg-brand-primary px-8 text-[18px] font-bold text-white" %>
        </div>
      <% end %>
    </div>
  </section>
</main>

<%= render "home/footer" %>
