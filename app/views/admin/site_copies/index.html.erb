<% content_for :title, "Textes du site | Admin" %>

<%= render "admin/nav" %>

<main class="px-6 py-10">
  <div class="mx-auto max-w-[1280px]">
    <h1 class="font-heading text-4xl font-bold text-brand-primary">Textes du site</h1>
    <p class="mt-3 max-w-3xl text-brand-text-secondary">Ces blocs apparaissent sur les pages publiques. Les numéros de téléphone de la page Contact se renseignent ici.</p>

    <div class="mt-10 space-y-10">
      <% @groups.each do |group, copies| %>
        <section>
          <h2 class="font-heading text-2xl font-bold text-brand-primary"><%= SiteCopy::GROUPS.fetch(group, group) %></h2>
          <div class="mt-4 overflow-hidden rounded-[24px] border border-[#E7E2DC] bg-white">
            <% copies.each do |copy| %>
              <article class="flex flex-col gap-4 border-b border-[#E7E2DC] p-5 last:border-b-0 sm:flex-row sm:items-start sm:justify-between">
                <div class="min-w-0 flex-1">
                  <p class="font-bold text-brand-text"><%= copy.label %></p>
                  <p class="mt-1 text-xs text-brand-text-secondary"><%= copy.key %></p>
                  <p class="mt-3 whitespace-pre-line text-sm leading-6 text-brand-text-secondary"><%= copy.value.presence || "—" %></p>
                </div>
                <%= link_to "Modifier", edit_admin_site_copy_path(copy), class: "inline-flex min-h-[44px] shrink-0 items-center rounded-full bg-brand-primary px-5 font-bold text-white" %>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  </div>
</main>
