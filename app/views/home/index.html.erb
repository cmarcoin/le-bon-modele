<% content_for :title, "Le Bon Modèle" %>

<%= render "home/header" %>

<main class="relative overflow-hidden pt-24">
  <%= render "home/background_pattern" %>
  <section class="px-8 pt-16 pb-8 lg:px-12 lg:pt-20 lg:pb-10">
    <div class="mx-auto grid max-w-[1280px] items-center gap-8 lg:grid-cols-[0.92fr_1.08fr] lg:gap-10">
      <div>
        <% hero_lines = site_copy("home.hero_title", "Choisissez la voiture qu’il vous faut. Pas celle qu’on cherche à vous vendre").split(/(?<=\.)\s+/) %>
        <h1 class="max-w-[980px] font-heading text-[40px] leading-[1.08] sm:text-[52px] lg:text-[50px]">
          <% hero_lines.each_with_index do |line, index| %>
            <span class="font-semibold text-brand-primary"><%= line %></span>
            <% if index < hero_lines.length - 1 %><br><% end %>
          <% end %>
        </h1>

        <p class="mt-6 max-w-[920px] text-[22px] leading-[1.45] text-brand-text-secondary sm:text-[24px]">
          <%= highlight_le_bon_modele(site_copy("home.hero_subtitle", "Bien acheter, c’est être bien conseillé. Avec Le Bon Modèle, deux experts indépendants vous accompagnent, pas à pas, pour choisir la voiture la plus adaptée à votre quotidien et à votre budget.")) %>
        </p>

        <div class="mt-8 flex flex-wrap gap-10 text-[18px] font-semibold text-brand-text-secondary">
          <span class="inline-flex items-center gap-3"><span class="text-brand-primary">✓</span>Sans commission</span>
          <span class="inline-flex items-center gap-3"><span class="text-brand-primary">✓</span>Experts indépendants</span>
        </div>
      </div>

      <div class="flex items-center justify-center lg:justify-end">
        <%= image_tag "/reference-assets/famille-voitures.svg", width: 1181, height: 614, alt: "Illustration de voitures pour toute la famille", class: "h-auto w-full max-w-none scale-105 lg:scale-110 lg:origin-center", loading: "lazy" %>
      </div>
    </div>
  </section>

  <section id="approche" class="px-8 py-16 lg:px-12 lg:py-20">
    <div class="mx-auto max-w-[1280px]">
      <div class="text-center">
        <h2 class="font-heading text-3xl font-bold text-brand-primary sm:text-4xl">Notre approche</h2>
        <div class="mx-auto mt-4 max-w-5xl space-y-3 text-base leading-7 text-brand-text-secondary sm:text-lg">
          <% site_copy("home.approach", "Sur le papier, acheter une voiture peut sembler simple.\nEn réalité, entre la multitude de marques et de modèles, de motorisations et d’options, d’annonces et de modes d’achat, c’est difficile de s’y retrouver.\nAvec Le Bon Modèle, on vous aide à y voir clair : de vrais conseillers vous guident pas à pas pour choisir et acheter la voiture la plus adaptée à votre quotidien et à votre budget, sans angles morts.").split(/\n+/).each do |paragraph| %>
            <p><%= highlight_le_bon_modele(paragraph) %></p>
          <% end %>
        </div>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <% [
          [ site_copy("home.block_1_title", "On est passés par là"), site_copy("home.block_1_body", "Derrière Le Bon Modèle, il n’y a pas d’IA, mais Charles et Jules : deux conducteurs qui savent par expérience à quel point acheter une voiture peut être complexe, et qui ont appris à comparer les offres, décrypter les prix et dénicher les bonnes affaires.") ],
          [ site_copy("home.block_2_title", "Conseillers indépendants"), site_copy("home.block_2_body", "Nous ne vendons pas de voitures. Nous ne prenons pas de commission. Notre métier, c’est de vous fournir un avis d’expert objectif, pour vous aider à faire un choix éclairé.\nEt notre seul client, c’est vous.") ],
          [ site_copy("home.block_3_title", "Double expertise"), site_copy("home.block_3_body", "Nous combinons une connaissance approfondie des véhicules avec une compréhension fine de vos besoins et de vos contraintes.\nNous appliquons une méthode rigoureuse et privilégions des échanges directs, au téléphone ou en visio, pour vous accompagner pas à pas.") ]
        ].each do |title, body| %>
          <article class="rounded-brand border border-brand-border bg-white p-6 text-center shadow-brand">
            <%= image_tag "/reference-assets/check.svg", width: 72, height: 72, alt: "", class: "mx-auto" %>
            <h3 class="mt-4 font-heading text-2xl font-bold text-brand-primary"><%= title %></h3>
            <div class="mt-3 space-y-2 text-sm leading-6 text-brand-primary">
              <% body.split(/\n+/).each do |paragraph| %>
                <p><%= highlight_le_bon_modele(paragraph) %></p>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    </div>
  </section>

  <%= render "home/contact_banner" %>

  <section id="offres" class="px-6 py-16 lg:px-12 lg:py-20">
    <div class="mx-auto max-w-[1280px]">
      <div class="text-center">
        <h2 class="font-heading text-4xl font-bold text-brand-primary sm:text-5xl">Nos accompagnements</h2>
      </div>

      <div class="mt-12 grid items-stretch gap-6 lg:grid-cols-2">
        <%= render "home/offer_card", path: starter_pack_path, icon_path: @starter_pack.icon_path, title: @starter_pack.name, accent_class: "text-brand-primary", objective: @starter_pack.objective, description: @starter_pack.description, price: euro_price(@starter_pack.price_cents), cta: "Découvrir" %>
        <%= render "home/offer_card", path: pack_premium_path, icon_path: @premium_pack.icon_path, title: @premium_pack.name, accent_class: "text-brand-primary", objective: @premium_pack.objective, description: @premium_pack.description, price: euro_price(@premium_pack.price_cents), cta: "Découvrir" %>
      </div>
    </div>
  </section>

  <section class="px-8 py-16 lg:px-12 lg:py-20">
    <div class="mx-auto max-w-[1280px]">
      <div class="text-center">
        <h2 class="font-heading text-3xl font-bold text-brand-primary sm:text-4xl">Avis clients</h2>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <% [
          [ "Volkswagen Touran + Renault Twingo E-Tech", "à Claire & Marc L., Haute-Savoie", "Entre notre monospace à 250 000 km et la BMW en leasing, on ne savait plus si on remplaçait une ou deux voitures. Vélos, plongée, trajets pro jusqu’à Grenoble… nos besoins étaient compliqués. On a revendu la BMW 15 000 €, acheté un Touran d’occasion et une Twingo électrique à 14 000 € — largement en dessous des 45 000 € qu’on avait envisagés. Et surtout, pas de discours commercial." ],
          [ "Toyota Touring Sports", "à Émilie R., lac d’Annecy", "Deux enfants, du matériel de camping à chaque week-end en montagne, et un contrôle technique dans deux mois avec une alerte liquide de refroidissement. On hésitait entre break et SUV, avec seulement 20 000 €. Grâce à l’accompagnement, on a trouvé un beau Toyota Touring Sports à ce prix : un coffre au niveau de notre ancien monospace, une voiture qui a de la gueule, et enfin un choix clair." ],
          [ "Dacia Duster", "à Nathalie V., Chambéry", "Après un accident, plus de voiture, une recherche urgente et un budget de 40 000 € en tête. Je pensais au full électrique, mais notre garage fait environ 2 m de haut. On a creusé mes vrais trajets — 1 500 km par an, quelques autoroutes pour l’Oléron — et j’ai fini par acheter un Duster pour 25 000 €. Moins dépensé, plus adapté, et mon fils avec son BMX rentre dedans." ]
        ].each do |model, customer, quote| %>
          <article class="rounded-[20px] bg-white p-6 shadow-brand">
            <p class="text-sm font-bold text-brand-primary">On a trouvé la voiture parfaite :</p>
            <h3 class="mt-2 font-heading text-xl font-bold text-brand-text"><%= model %></h3>
            <p class="text-sm text-brand-text-secondary"><%= customer %></p>
            <p class="mt-4 text-sm leading-6 text-brand-text-secondary"><%= quote %></p>
          </article>
        <% end %>
      </div>
    </div>
  </section>
</main>

<%= render "home/footer" %>
