<footer>
  <div class="h-0.5 w-full bg-[#E3DDD5]"></div>

  <div class="px-6 lg:px-12">
  <div class="mx-auto max-w-[1280px] pt-16">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-stretch">
      <div class="lg:flex-[1.25] lg:pr-16">
        <%= link_to root_path, aria: { label: "Le Bon Modèle" } do %>
          <%= image_tag "/reference-assets/logo.png", alt: "Le Bon Modèle", class: "h-10 w-auto" %>
        <% end %>
        <p class="mt-5 max-w-[460px] text-base leading-[1.6] text-brand-text-secondary">Bien acheter, c’est être bien conseillé.</p>
        <p class="mt-3 max-w-[460px] text-base leading-[1.6] text-brand-text-secondary">
          Avec Le Bon Modèle, deux experts indépendants vous accompagnent, pas à pas, pour choisir la voiture la plus adaptée à votre quotidien et à votre budget.
        </p>
      </div>

      <div class="flex flex-col gap-8 border-[#E3DDD5] max-lg:border-t max-lg:pt-8 md:flex-row md:gap-10 lg:contents">
      <nav class="md:w-1/2 lg:w-auto lg:border-x lg:border-[#E3DDD5] lg:px-16" aria-label="Navigation du pied de page">
        <ul class="flex flex-col gap-3.5 font-heading text-base font-medium text-brand-text">
          <li><%= link_to "Accueil", root_path, class: "transition hover:text-brand-primary" %></li>
          <li><%= link_to "Pack Conseil", starter_pack_path, class: "transition hover:text-brand-primary" %></li>
          <li><%= link_to "Pack Achat", pack_premium_path, class: "transition hover:text-brand-primary" %></li>
          <li><%= link_to "Qui sommes-nous ?", about_path, class: "transition hover:text-brand-primary" %></li>
          <li><%= link_to "FAQ", faq_path, class: "transition hover:text-brand-primary" %></li>
        </ul>
      </nav>

      <div class="border-[#E3DDD5] max-md:border-t max-md:pt-8 md:max-lg:w-1/2 lg:flex-1 lg:pl-16">
        <ul class="grid grid-cols-3 gap-4 text-center">
          <% [
            [ "Conseillers", "indépendants", "users" ],
            [ "Sans", "commission", "percent" ],
            [ "Réponse", "sous 24 h", "clock" ]
          ].each do |first, second, icon| %>
            <li>
              <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-brand-primary-light text-brand-primary">
                <%= render "home/footer_icon", name: icon %>
              </span>
              <p class="mt-3 text-sm font-bold leading-[1.35] text-brand-text"><%= first %><br><%= second %></p>
            </li>
          <% end %>
        </ul>
        <%= link_to "Une question ? Contactez-nous", contact_path, class: "mt-7 inline-flex h-14 w-full items-center justify-center rounded-full bg-brand-primary px-6 text-base font-bold text-white transition hover:-translate-y-0.5 hover:shadow-soft" %>
      </div>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-center gap-4 border-t border-[#EFEAE4] py-6 pb-8 text-center text-sm text-brand-text-secondary md:flex-row md:justify-between md:text-left">
      <ul class="order-1 flex flex-col items-center gap-2.5 md:order-2 md:flex-row md:gap-5">
        <li><%= link_to "Mentions légales", legal_notices_path, class: "transition hover:text-brand-primary" %></li>
        <li class="hidden h-3.5 w-px bg-[#E3DDD5] md:block" aria-hidden="true"></li>
        <li><%= link_to "Politique de confidentialité", privacy_policy_path, class: "transition hover:text-brand-primary" %></li>
        <li class="hidden h-3.5 w-px bg-[#E3DDD5] md:block" aria-hidden="true"></li>
        <li><%= link_to "CGV", terms_of_sale_path, class: "transition hover:text-brand-primary" %></li>
        <% if ENV["GA_MEASUREMENT_ID"].present? %>
          <li class="hidden h-3.5 w-px bg-[#E3DDD5] md:block" aria-hidden="true"></li>
          <li>
            <button onclick="window.cookieConsentController?.show()"
                    class="transition hover:text-brand-primary">
              Gérer les cookies
            </button>
          </li>
        <% end %>
      </ul>
      <p class="order-2 md:order-1">© <%= Date.current.year %> Le Bon Modèle</p>
    </div>
  </div>
  </div>
</footer>
