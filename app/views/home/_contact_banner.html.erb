<section class="px-6 pb-0 pt-[150px] lg:px-12">
  <div class="relative mx-auto w-full max-w-[1280px]">
    <%= image_tag "/reference-assets/contact.gif", alt: "Personne qui fait défiler des annonces auto", class: "contact-desktop-image" %>

    <div class="relative overflow-hidden rounded-[28px] bg-brand-primary-light">
      <%= image_tag "/reference-assets/trait.svg", alt: "", aria: { hidden: true }, class: "contact-trait" %>

      <div class="relative z-10 flex min-h-[320px] flex-col items-center justify-center px-6 py-10 text-center md:px-8 lg:flex-row lg:items-center lg:justify-end lg:px-8 lg:text-left">
        <div class="hidden w-[600px] shrink-0 lg:block"></div>

        <div class="max-w-none lg:flex-1 lg:pr-4">
          <h2 class="font-heading text-[32px] font-extrabold leading-none text-brand-primary sm:text-[40px] lg:whitespace-nowrap">Difficile de faire le bon choix…</h2>
          <p class="mt-3 text-[20px] leading-tight text-brand-text">La jungle des annonces, c’est notre problème, plus le vôtre.</p>
        </div>
      </div>
    </div>
  </div>
</section>
