<section class="px-6 pb-0 pt-[150px] lg:px-12">
  <div class="relative mx-auto w-full max-w-[1280px]">
    <%= image_tag "/reference-assets/contact.gif", alt: "Personne qui fait défiler des annonces auto", class: "contact-desktop-image" %>

    <div class="relative overflow-hidden rounded-[28px] bg-brand-primary-light">
      <%= image_tag "/reference-assets/trait.svg", alt: "", aria: { hidden: true }, class: "contact-trait" %>

      <div class="relative z-10 flex flex-col items-center justify-center px-6 py-8 text-center lg:min-h-[320px] lg:flex-row lg:items-center lg:justify-end lg:px-8 lg:py-10 lg:text-left">
        <%= image_tag "/reference-assets/contact.gif", alt: "", class: "mb-6 h-auto w-full max-w-[240px] lg:hidden" %>
        <div class="hidden shrink-0 lg:block lg:w-[460px] xl:w-[568px]"></div>

        <div class="max-w-none lg:flex-1 lg:pr-4">
          <h2 class="font-heading text-[32px] font-extrabold leading-[1.1] text-brand-primary xl:text-[40px]">Vous ne savez pas quelle voiture<br class="hidden min-[1440px]:inline"> choisir ?</h2>
          <p class="mt-7 text-[20px] leading-tight text-brand-text">La jungle des annonces, c’est notre problème, plus le vôtre.</p>
        </div>
      </div>
    </div>
  </div>
</section>
