<section class="px-4 py-12 md:px-6 lg:px-8">
  <div class="relative mx-auto w-full max-w-[1280px]">
    <%= image_tag "/reference-assets/contact.gif", alt: "Personne qui fait défiler des annonces auto", class: "contact-desktop-image" %>

    <div class="relative overflow-hidden rounded-[28px] bg-brand-primary-light">
      <%= image_tag "/reference-assets/trait.svg", alt: "", aria: { hidden: true }, class: "contact-trait" %>

      <div class="relative z-10 flex min-h-[320px] flex-col items-center justify-center px-6 py-10 text-center md:px-8 lg:flex-row lg:items-center lg:justify-end lg:px-12 lg:text-left">
        <div class="hidden w-[420px] shrink-0 lg:block"></div>

        <div class="max-w-[560px] lg:flex-1" data-controller="rotating-copy" data-rotating-copy-interval-value="4200">
          <% [
            ["Vous ne savez pas quelle voiture choisir ?", "La jungle des annonces, c’est notre problème, plus le vôtre"],
            ["Perdu(e) face à toutes ces offres ?", "La jungle des annonces, c’est notre problème, plus le vôtre"],
            ["Difficile de faire le bon choix…", "La jungle des annonces, c’est notre problème, plus le vôtre"]
          ].each_with_index do |(title, subtitle), index| %>
            <div data-rotating-copy-target="item" class="<%= index.zero? ? "" : "hidden" %>">
              <h2 class="font-heading text-[34px] font-bold leading-[0.95] text-brand-primary sm:text-[42px]"><%= title %></h2>
              <p class="mt-3 text-[18px] leading-tight text-brand-primary sm:text-[20px]"><%= subtitle %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
