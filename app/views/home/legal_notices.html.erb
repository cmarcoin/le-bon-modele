<% content_for :title, "Mentions légales | Le Bon Modèle" %>

<%= render "home/header" %>

<main class="relative pt-24">
  <%= render "home/background_pattern" %>

  <section class="relative px-6 py-8 lg:px-12 lg:py-10">
    <div class="mx-auto max-w-[880px]">
      <h1 class="font-heading text-[36px] font-black leading-[0.98] text-brand-primary lg:text-[48px]">Mentions légales</h1>

      <div class="mt-12 space-y-10 text-base leading-[1.6] text-brand-text-secondary lg:text-lg">

        <!-- Éditeur du site -->
        <article>
          <h2 class="mb-4 font-heading text-2xl font-bold text-brand-text">Éditeur du site</h2>
          <p>Le site <strong>lebonmodele.fr</strong> est édité par <strong>Le Bon Modèle</strong>, service de conseil automobile indépendant.</p>
          <p class="mt-3"><strong>Fondateurs :</strong> Charles Marcoin et Jules Delmas</p>
          <div class="mt-3 rounded-lg bg-amber-50 border border-amber-200 px-4 py-3 text-sm">
            <p class="font-semibold text-amber-900">Informations légales à compléter :</p>
            <ul class="mt-2 space-y-1 text-amber-800">
              <li>• Forme juridique : <strong>[À COMPLÉTER : SARL, SAS, auto-entrepreneur, etc.]</strong></li>
              <li>• Numéro SIREN : <strong>[À COMPLÉTER : XXX XXX XXX]</strong></li>
              <li>• Numéro SIRET : <strong>[À COMPLÉTER : XXX XXX XXX XXXXX]</strong></li>
              <li>• RCS : <strong>[À COMPLÉTER : ville et numéro]</strong></li>
              <li>• Capital social : <strong>[À COMPLÉTER : montant en euros]</strong></li>
              <li>• Numéro de TVA intracommunautaire : <strong>[À COMPLÉTER : FRXX XXXXXXXXX]</strong></li>
              <li>• Adresse du siège social : <strong>[À COMPLÉTER : adresse complète]</strong></li>
            </ul>
          </div>
        </article>

        <!-- Directeur de la publication -->
        <article>
          <h2 class="mb-4 font-heading text-2xl font-bold text-brand-text">Directeur de la publication</h2>
          <p><strong>[À COMPLÉTER : Nom du directeur de la publication]</strong></p>
        </article>

        <!-- Contact -->
        <article>
          <h2 class="mb-4 font-heading text-2xl font-bold text-brand-text">Contact</h2>
          <p><strong>Email :</strong> <a href="mailto:contact@lebonmodele.fr" class="text-brand-primary underline hover:no-underline">contact@lebonmodele.fr</a></p>
          <p class="mt-2"><strong>Téléphone :</strong> <strong class="text-amber-700">[À COMPLÉTER : numéro de téléphone]</strong></p>
        </article>

        <!-- Hébergeur -->
        <article>
          <h2 class="mb-4 font-heading text-2xl font-bold text-brand-text">Hébergeur</h2>
          <p>Le site est hébergé par :</p>
          <p class="mt-3">
            <strong>Scalingo SAS</strong><br>
            15 avenue du Rhin<br>
            67100 Strasbourg<br>
            France
          </p>
          <p class="mt-3">
            <strong>RCS :</strong> Strasbourg B 808 665 483<br>
            <strong>Site web :</strong> <a href="https://scalingo.com" target="_blank" rel="noopener noreferrer" class="text-brand-primary underline hover:no-underline">scalingo.com</a>
          </p>
        </article>

        <!-- Propriété intellectuelle -->
        <article>
          <h2 class="mb-4 font-heading text-2xl font-bold text-brand-text">Propriété intellectuelle</h2>
          <p>L'ensemble des contenus présents sur le site lebonmodele.fr (textes, images, graphismes, logo, icônes, etc.) est la propriété exclusive du Bon Modèle, à l'exception des marques, logos et contenus appartenant à d'autres sociétés partenaires ou auteurs.</p>
          <p class="mt-3">Toute reproduction, distribution, modification, adaptation, retransmission ou publication de ces différents éléments est strictement interdite sans l'accord exprès par écrit du Bon Modèle.</p>
        </article>

        <!-- Crédits -->
        <article>
          <h2 class="mb-4 font-heading text-2xl font-bold text-brand-text">Crédits</h2>
          <p><strong>Conception et développement :</strong> Le Bon Modèle</p>
          <p class="mt-2"><strong>Illustrations :</strong> Le Bon Modèle</p>
        </article>

      </div>

      <div class="mb-12 mt-16 flex flex-col items-start justify-between gap-6 rounded-[24px] bg-brand-primary-light px-8 py-11 md:flex-row md:items-center md:px-12 lg:mb-20">
        <div>
          <h2 class="font-heading text-[28px] font-bold text-brand-text">Une question ?</h2>
          <p class="mt-2.5 text-base text-brand-text">Contactez-nous pour toute demande d'information.</p>
        </div>
        <%= link_to "Nous contacter", contact_path, class: "inline-flex h-14 w-full items-center justify-center rounded-full bg-brand-primary px-8 text-base font-bold text-white md:w-auto" %>
      </div>
    </div>
  </section>
</main>

<%= render "home/footer" %>
