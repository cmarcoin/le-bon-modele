<% content_for :title, "#{@starter_pack.name} | Le Bon Modèle" %>
<% offer_button = "inline-flex min-h-16 items-center justify-center rounded-full bg-brand-primary px-8 text-[18px] font-bold text-white transition-all duration-200 ease-out hover:-translate-y-[2px] hover:shadow-[0_14px_36px_rgba(31,95,60,0.22)]" %>
<% steps = [
  { number: "1", icon: "document", title: "Questionnaire préparatoire", body: "Nous vous envoyons un questionnaire pour préparer le premier entretien, afin de cadrer vos usages et vos priorités." },
  { number: "2", icon: "chat", title: "Premier entretien avec Charles et Jules", body: "Un échange en visio ou par téléphone.", duration: "60 min" },
  { number: "3", icon: "car", title: "Liste réduite de 2 à 3 modèles", body: "Nous sélectionnons les modèles les plus adaptés à vos besoins. Vous recevez une synthèse avec nos recommandations, des repères de prix et les points de vigilance à connaître." },
  { number: "4", icon: "calendar", title: "Entretien de suivi avec Charles et Jules", body: "Un second échange pour répondre à vos questions et vous aider à poursuivre votre achat.", duration: "30 min" }
] %>

<%= render "home/header" %>

<main class="relative pt-24">
  <%= render "home/background_pattern" %>
  <section class="relative px-6 py-8 lg:px-12 lg:py-10">
    <div class="mx-auto max-w-[1280px]">
      <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:gap-14">
        <article>
          <div class="lg:pt-[108px]">
            <div class="lg:w-fit lg:max-w-full">
              <h1 class="font-heading text-5xl font-black leading-[0.95] text-brand-primary"><%= @starter_pack.name %></h1>
              <div class="mt-6 h-px bg-[#D9D9D9]"></div>
              <p class="mt-6 text-[20px] font-normal text-brand-text-secondary">Objectif :</p>
              <p class="mt-2 font-heading text-[28px] font-bold leading-[1.05] text-brand-text lg:text-[40px]">Identifier la voiture qu’il vous faut</p>
              <p class="mt-6 text-justify text-[20px] leading-[1.45] text-brand-text-secondary lg:[contain:inline-size]">
                Passez 90 min avec nos deux experts auto pour identifier le bon modèle
                de voiture à acheter, celui qui correspond vraiment à vos besoins, vos
                contraintes et votre budget.
              </p>
            </div>

            <div class="mt-9 flex flex-wrap items-center gap-8">
              <div class="font-heading leading-none text-brand-text">
                <span class="text-[48px] font-black tracking-[-0.04em]"><%= euro_price(@starter_pack.price_cents) %></span>
                <span class="ml-1.5 text-[19.5px] font-medium">TTC</span>
              </div>
              <%= link_to "Je choisis cette offre", new_pack_booking_path(@starter_pack), class: offer_button %>
            </div>
          </div>
        </article>

        <aside class="starter-pack-visual" aria-label="Ce que vous gagnez avec le <%= @starter_pack.name %>">
          <figure class="hidden lg:-mt-10 lg:block">
            <%= image_tag "/reference-assets/starter-pack-illustration-hero.svg",
                  width: 1122,
                  height: 1228,
                  alt: "Charles et Jules autour d’un ordinateur. On clarifie vos vrais besoins, on explique les différences entre modèles, motorisations, finitions et options, on éclaire le coût total de possession, la revente et les garanties, et on identifie ensemble les équipements qu’il vous faut.",
                  class: "h-auto w-full lg:ml-[-40px] lg:w-[calc(100%_+_40px)] lg:max-w-none xl:ml-[-80px] xl:w-[calc(100%_+_80px)]",
                  loading: "lazy" %>
          </figure>

          <div class="lg:hidden">
            <%= image_tag "/reference-assets/starter-pack-scene.png",
                  width: 980,
                  height: 660,
                  alt: "",
                  class: "mx-auto h-auto w-full",
                  loading: "lazy" %>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="relative px-6 pb-[72px] pt-16 lg:px-12">
    <div class="mx-auto max-w-[1280px]">
      <h2 class="text-center font-heading text-[40px] font-extrabold leading-[1.1] tracking-[-0.01em] text-brand-primary">Votre accompagnement en 4 étapes</h2>
      <div class="mt-14">
        <%= render "home/accompaniment_track", steps: steps %>
      </div>
    </div>
  </section>

  <section class="relative px-6 py-16 lg:px-12 lg:pb-[136px] lg:pt-24">
    <div class="mx-auto grid max-w-[1280px] items-center gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:items-start lg:gap-16 xl:gap-20">
      <%= image_tag "/reference-assets/conclusion-experts-cliente.svg",
            alt: "Charles et Jules aident une cliente à choisir sa voiture sur un ordinateur portable",
            class: "order-2 h-auto w-full lg:order-1",
            loading: "lazy" %>
      <div class="max-lg:contents lg:order-2 lg:pt-14">
        <h2 class="order-1 font-heading text-[32px] font-extrabold leading-[1.08] tracking-[-0.01em] text-brand-text xl:text-[40px]">
          Nous transformons<br>
          une idée floue<br>
          en <span class="text-brand-primary">un choix clair</span>
        </h2>
        <%= link_to "Je choisis cette offre", new_pack_booking_path(@starter_pack), class: "#{offer_button} order-3 max-lg:mt-0 lg:mt-10" %>
      </div>
    </div>
  </section>
</main>

<%= render "home/footer" %>
