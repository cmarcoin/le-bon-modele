<% content_for :title, "#{@premium_pack.name} | Le Bon Modèle" %>
<% offer_button = "inline-flex min-h-16 items-center justify-center rounded-full bg-brand-primary px-8 text-[18px] font-bold text-white transition-all duration-200 ease-out hover:-translate-y-[2px] hover:shadow-[0_14px_36px_rgba(31,95,60,0.22)]" %>
<% phase_one = [
  { number: "1", icon: "document", title: "Questionnaire préparatoire", body: "Nous vous envoyons un questionnaire pour préparer le premier entretien, afin de cadrer vos usages et vos priorités." },
  { number: "2", icon: "chat", title: "Entretien n°1 avec Charles et Jules", body: "Un échange en visio ou par téléphone.", duration: "60 min" },
  { number: "3", icon: "car", title: "Liste réduite de 2 à 3 modèles", body: "Nous sélectionnons les modèles les plus adaptés à vos besoins. Vous recevez une synthèse avec nos recommandations, des repères de prix et les points de vigilance à connaître." },
  { number: "4", icon: "check", title: "Entretien n°2 avec Charles et Jules", body: "Nous échangeons sur les véhicules sélectionnés et validons ensemble le modèle à acheter.", duration: "60 min" }
] %>
<% phase_two = [
  { number: "5", icon: "search", title: "Recherche, tri et analyse des offres", body: "Nous identifions les meilleures offres sur le marché du neuf et de l’occasion et vous proposons une sélection de 4 à 5 annonces, accompagnée d’un comparatif détaillé et de nos recommandations." },
  { number: "6", icon: "car_check", title: "Entretien n°3 avec Charles et Jules", body: "Nous passons les annonces en revue, approfondissons les recherches le cas échéant, arbitrons les produits annexes (entretien, garanties, assurance) et vous accompagnons jusqu’à la finalisation de votre achat.", duration: "60 min" }
] %>

<%= render "home/header" %>

<main class="relative pt-24">
  <%= render "home/background_pattern" %>
  <section class="relative px-6 py-8 lg:px-12 lg:py-10">
    <div class="mx-auto max-w-[1280px]">
      <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:gap-14">
        <article>
          <div class="lg:pt-[108px]">
            <div class="lg:w-fit lg:max-w-full">
              <h1 class="font-heading text-5xl font-black leading-[0.95] text-brand-primary"><%= @premium_pack.name %></h1>
              <div class="mt-6 h-px bg-[#D9D9D9]"></div>
              <p class="mt-6 text-[20px] font-normal text-brand-text-secondary">Objectif :</p>
              <p class="mt-2 font-heading text-[40px] font-bold leading-[1.05] text-brand-text">Choisir le bon modèle,<br>puis trouver la meilleure offre</p>
              <p class="mt-6 text-left text-[20px] leading-[1.45] tracking-[-0.012em] text-brand-text-secondary lg:[contain:inline-size]">
                Du cadrage de votre besoin jusqu’à l’achat de votre voiture, nos deux experts auto vous accompagnent à chaque étape.
              </p>
            </div>

            <div class="mt-9 flex flex-wrap items-center gap-8">
              <div class="font-heading leading-none text-brand-text">
                <span class="text-[48px] font-black tracking-[-0.04em]"><%= euro_price(@premium_pack.price_cents) %></span>
                <span class="ml-1.5 text-[19.5px] font-medium">TTC</span>
              </div>
              <%= link_to "Je choisis cette offre", new_pack_booking_path(@premium_pack), class: offer_button %>
            </div>
          </div>
        </article>

        <aside class="starter-pack-visual" aria-label="Ce que vous gagnez avec le <%= @premium_pack.name %>">
          <figure class="hidden lg:-mt-10 lg:block">
            <%= image_tag "/reference-assets/pack-premium-illustration-hero.svg",
                  width: 1122,
                  height: 1262,
                  alt: "Charles et Jules analysent des annonces auto. On définit le modèle et les équipements qu’il vous faut, on analyse toutes les offres du marché, on décortique les prix et on repère les fausses bonnes affaires. Garanties, entretien, assistance, assurances : on ne garde que ce qui est pertinent. On creuse jusqu’à trouver les meilleures offres.",
                  class: "h-auto w-full lg:ml-[-40px] lg:w-[calc(100%+40px)] lg:max-w-none xl:ml-[-80px] xl:w-[calc(100%+80px)]",
                  loading: "lazy" %>
          </figure>

          <div class="lg:hidden">
            <div class="starter-pack-quotes">
              <p class="starter-pack-quote">On définit le modèle et les équipements qu’il vous faut</p>
              <p class="starter-pack-quote">On analyse toutes les offres du marché, on décortique les prix, on repère les fausses bonnes affaires</p>
            </div>

            <%= image_tag "/reference-assets/pack-premium-scene.png",
                  width: 1040,
                  height: 720,
                  alt: "",
                  class: "starter-pack-scene",
                  loading: "lazy" %>

            <div class="starter-pack-quotes">
              <p class="starter-pack-quote">Garanties, entretien, assistance, assurances : on vous aide à ne garder que ce qui est pertinent</p>
              <p class="starter-pack-quote">On creuse… jusqu’à trouver les meilleures offres</p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="relative px-6 pb-[72px] pt-16 lg:px-12">
    <div class="mx-auto max-w-[1280px]">
      <h2 class="text-center font-heading text-[40px] font-extrabold leading-[1.1] tracking-[-0.01em] text-brand-primary">Votre accompagnement en 2 phases</h2>
      <h3 class="mt-14 text-center font-heading text-2xl font-bold text-brand-text">Phase 1 – Choisir le bon modèle</h3>
      <div class="mt-10">
        <%= render "home/accompaniment_track", steps: phase_one %>
      </div>
      <h3 class="mt-20 text-center font-heading text-2xl font-bold text-brand-text">Phase 2 – Trouver la meilleure offre</h3>
      <div class="mt-10">
        <%= render "home/accompaniment_track", steps: phase_two, pair: true %>
      </div>

      <div class="mt-16 flex items-center justify-center gap-3.5">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-primary-light text-brand-primary">
          <svg class="h-[22px] w-[22px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </span>
        <p class="max-w-4xl text-left text-[18px] leading-[1.6] text-brand-text">Entre les rendez-vous, Charles et Jules restent joignables par email et par téléphone pour répondre à vos questions.</p>
      </div>
    </div>
  </section>

  <section class="relative px-6 py-16 lg:px-12 lg:pb-[136px] lg:pt-24">
    <div class="mx-auto grid max-w-[1280px] items-center gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:gap-20">
      <%= image_tag "/reference-assets/contact.gif",
            width: 480,
            height: 470,
            alt: "Personne qui fait défiler des annonces auto",
            class: "order-2 mx-auto h-auto w-[280px] lg:order-1 lg:w-[480px]" %>
      <div class="order-1 text-left lg:order-2">
        <h2 class="font-heading text-[32px] font-extrabold leading-[1.08] tracking-[-0.01em] text-brand-text lg:text-[40px]">
          La jungle des annonces,<br>
          c’est notre problème,<br>
          <span class="text-brand-primary">plus le vôtre.</span>
        </h2>
        <%= link_to "Je choisis cette offre", new_pack_booking_path(@premium_pack), class: "#{offer_button} mt-10" %>
      </div>
    </div>
  </section>
</main>

<%= render "home/footer" %>
