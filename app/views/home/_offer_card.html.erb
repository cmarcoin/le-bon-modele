<% cta = local_assigns.fetch(:cta) %>
<% image_path = local_assigns.fetch(:image_path) %>

<%= link_to path, class: "group flex h-full flex-col rounded-[24px] border border-[#E7E2DC] bg-white px-9 py-10 shadow-soft transition hover:-translate-y-1 hover:shadow-hover" do %>
  <div class="flex min-h-20 items-center justify-between gap-4">
    <h3 class="font-heading text-[32px] font-bold leading-none text-brand-primary"><%= title %></h3>
    <%= image_tag image_path, width: 640, height: 343, alt: "", class: "h-auto w-[120px] shrink-0 lg:w-[170px]" %>
  </div>
  <div class="my-6 h-px w-full bg-[#EFEAE4]"></div>
  <p class="text-base font-normal text-brand-text-secondary">Objectif :</p>
  <p class="mt-2 font-heading text-[28px] font-bold leading-[1.15] text-brand-text"><%= objective %></p>
  <p class="mt-4 text-base leading-[1.6] text-brand-text-secondary"><%= description %></p>
  <div class="mt-auto flex flex-col items-start justify-between gap-6 pt-8 sm:flex-row sm:items-center">
    <span class="inline-flex h-14 items-center justify-center rounded-full bg-brand-primary px-7 text-base font-bold text-white"><%= cta %></span>
    <span class="font-heading leading-none text-brand-text">
      <span class="text-[48px] font-black tracking-[-0.04em]"><%= price %></span>
      <span class="ml-1.5 font-heading text-[20px] font-medium">TTC</span>
    </span>
  </div>
<% end %>
